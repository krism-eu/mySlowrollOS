<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>mySlowrollOS</vendor>
  <vendor_url>https://github.com/krism-eu/mySlowrollOS</vendor_url>

  <action id="org.myslowrollos.controlcenter.journalctl">
    <description>Clean system journal logs in mySlowrollOS Control Center</description>
    <description xml:lang="it">Pulizia registri Journal in mySlowrollOS Control Center</description>
    <message>Authentication is required to vacuum journal logs</message>
    <message xml:lang="it">Autenticazione richiesta per ripulire i registri del Journal</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/journalctl</annotate>
  </action>

  <action id="org.myslowrollos.controlcenter.efibootmgr">
    <description>Configure EFI boot entries in mySlowrollOS Control Center</description>
    <description xml:lang="it">Configurazione voci di avvio EFI in mySlowrollOS Control Center</description>
    <message>Authentication is required to modify EFI boot settings</message>
    <message xml:lang="it">Autenticazione richiesta per modificare le impostazioni di avvio EFI</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/efibootmgr</annotate>
  </action>

  <action id="org.myslowrollos.controlcenter.zypper">
    <description>Clean package cache in mySlowrollOS Control Center</description>
    <description xml:lang="it">Pulizia cache pacchetti Zypper in mySlowrollOS Control Center</description>
    <message>Authentication is required to manage package cache</message>
    <message xml:lang="it">Autenticazione richiesta per gestire la cache dei pacchetti</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/zypper</annotate>
  </action>

  <action id="org.myslowrollos.controlcenter.privacy">
    <description>Toggle Privacy and Isolation Mode in mySlowrollOS Control Center</description>
    <description xml:lang="it">Attiva o disattiva la Modalità Privacy in mySlowrollOS Control Center</description>
    <message>Authentication is required to toggle Privacy Mode</message>
    <message xml:lang="it">Autenticazione richiesta per commutare la Modalità Privacy</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/myslowroll-cc/scripts/privacy.sh</annotate>
  </action>
</policyconfig>
