#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_dir="$(cd -- "${script_dir}/.." && pwd)"
stage="${repo_dir}/out/obs/criscore1"

bash "${script_dir}/generate-criscore-spec"

rm -rf -- "${stage}"
mkdir -p -- "${stage}"
cp -- "${script_dir}/criscore.spec" "${stage}/criscore1.spec"
cp -- "${script_dir}/myslowroll-atomic-dup" "${stage}/myslowroll-atomic-dup"

cat <<EOF
OBS source pronto in:
  ${stage}

Creare/aggiornare nel proprio home project OBS un solo package sorgente chiamato:
  criscore1

e caricare entrambi i file:
  ${stage}/criscore1.spec
  ${stage}/myslowroll-atomic-dup

Lo spec produce entrambi i binari:
  criscore1
  criscore2

e criscore1 installa:
  /usr/sbin/myslowroll-atomic-dup

Per un checkout osc gia esistente:
  cp '${stage}/criscore1.spec' /work/home:krism/criscore1/
  cp '${stage}/myslowroll-atomic-dup' /work/home:krism/criscore1/
  cd /work/home:krism/criscore1
  osc addremove
  osc status
  osc commit -m 'Update criscore and atomic Slowroll upgrade wrapper'
EOF
