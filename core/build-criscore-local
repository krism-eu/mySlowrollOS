#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_dir="$(cd -- "${script_dir}/.." && pwd)"
topdir="${repo_dir}/out/criscore-rpmbuild"

if ! command -v rpmbuild >/dev/null 2>&1; then
    printf 'rpmbuild non trovato. Nel container installare: zypper in rpm-build\n' >&2
    exit 2
fi

bash "${script_dir}/generate-criscore-spec"

rm -rf -- "${topdir}/BUILD" "${topdir}/BUILDROOT" "${topdir}/RPMS" "${topdir}/SRPMS"
mkdir -p -- "${topdir}/BUILD" "${topdir}/BUILDROOT" "${topdir}/RPMS" \
    "${topdir}/SOURCES" "${topdir}/SPECS" "${topdir}/SRPMS"

cp -- "${script_dir}/criscore.spec" "${topdir}/SPECS/criscore.spec"
cp -- "${script_dir}/myslowroll-atomic-dup" "${topdir}/SOURCES/myslowroll-atomic-dup"

rpmbuild --define "_topdir ${topdir}" -ba "${topdir}/SPECS/criscore.spec"

printf '\nRPM prodotti:\n'
find "${topdir}/RPMS" -type f \( -name 'criscore1-*.rpm' -o -name 'criscore2-*.rpm' \) -print | LC_ALL=C sort
printf '\nSRPM:\n'
find "${topdir}/SRPMS" -type f -name 'criscore1-*.src.rpm' -print | LC_ALL=C sort
