<?xml version="1.0" encoding="utf-8"?>
<image schemaversion="8.0" name="myslowroll-workstation">
  <description type="system">
    <author>krism-eu</author>
    <contact>krism-eu</contact>
    <specification>Personal openSUSE Slowroll workstation rootfs for mySlowrollOS</specification>
  </description>

  <preferences>
    <version>0.1.0</version>
    <packagemanager>zypper</packagemanager>
    <type image="tbz" primary="true"/>
    <rpm-check-signatures>false</rpm-check-signatures>
  </preferences>

  <!-- Build repositories only. openSUSE-repos-Slowroll configures the installed system. -->
  <repository type="rpm-md" alias="slowroll-oss">
    <source path="https://download.opensuse.org/slowroll/repo/oss/"/>
  </repository>
  <repository type="rpm-md" alias="slowroll-update">
    <source path="https://download.opensuse.org/update/slowroll/repo/oss/"/>
  </repository>

  <!-- Minimal bootstrap needed by KIWI/Zypper before the image package phase. -->
  <packages type="bootstrap">
    <package name="filesystem"/>
    <package name="glibc-locale"/>
    <package name="cracklib-dict-full"/>
    <package name="ca-certificates"/>
    <package name="ca-certificates-mozilla"/>
    <package name="openSUSE-release"/>
    <package name="zypper"/>
  </packages>

