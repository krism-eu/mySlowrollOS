#!/usr/bin/env bash
set -Eeuo pipefail

# ==============================================================================
# mySlowrollOS - Aggiornamento di Sistema Transazionale
# Interfaccia da terminale Konsole per atomic-update
# ==============================================================================

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export MYSLOWROLL_AUTO_AGREE_LICENSES=1

# Se non siamo root, eleviamo con pkexec preservando l'ambiente grafico
if (( EUID != 0 )); then
    exec pkexec env DISPLAY="${DISPLAY:-}" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" XAUTHORITY="${XAUTHORITY:-}" "$0" "$@"
fi

readonly LOG_DIR=/var/log/myslowroll-atomic-update
mkdir -p -m 0700 "${LOG_DIR}"

LOG_RUN="${LOG_DIR}/desktop-update-$(date +%Y%m%d-%H%M%S).log"

print_header() {
    printf '\e[1;36m===================================================================\e[0m\n'
    printf '\e[1;36m                mySlowrollOS - Aggiornamento di Sistema            \e[0m\n'
    printf '\e[1;36m===================================================================\e[0m\n\n'
}

print_step() {
    local num="$1"
    local desc="$2"
    printf '\n\e[1;33m[%s/3] %s...\e[0m\n' "${num}" "${desc}"
    printf '\e[90m-------------------------------------------------------------------\e[0m\n'
}

run_update() {
    print_header
    printf 'Avvio sessione: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf 'Log sessione:   %s\n' "${LOG_RUN}"

    print_step "1" "Verifica diagnostica preflight di sistema"
    /usr/sbin/atomic-update check

    print_step "2" "Analisi repository e download dei pacchetti"
    /usr/sbin/atomic-update plan

    # Verifica se vi sono aggiornamenti
    local st
    st="$(/usr/sbin/atomic-update status 2>/dev/null | awk '/^State:/ {print $2}')"
    if [[ "${st}" == "confirmed" ]]; then
        printf '\n\e[1;32m[mySlowrollOS] Il sistema e gia aggiornato. Nessuna operazione richiesta.\e[0m\n'
        printf '\nPremi INVIO per chiudere questa finestra...\n'
        read -r _ || true
        return 0
    fi

    print_step "3" "Installazione atomica nella nuova snapshot e verifica boot"
    printf 'AGGIORNA OFFLINE E RIAVVIA\n' | /usr/sbin/atomic-update upgrade

    printf '\n\e[1;32m===================================================================\e[0m\n'
    printf '\e[1;32m  Aggiornamento completato con successo!                          \e[0m\n'
    printf '\e[1;32m===================================================================\e[0m\n'

    if [[ "${MYSLOWROLL_AUTO_REBOOT:-1}" == "0" ]]; then
        printf '\n\e[1;33m[mySlowrollOS] Modalita ispezione: riavvio automatico disabilitato.\e[0m\n'
        printf 'Il sistema e pronto nella nuova snapshot. Riavviare manualmente quando desiderato.\n'
        return 0
    fi
}

# Eseguiamo inviando sia a terminale che a log
run_update 2>&1 | tee "${LOG_RUN}"
