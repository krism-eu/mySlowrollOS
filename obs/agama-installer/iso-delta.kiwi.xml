<!--
    iso-delta.kiwi.xml
    Delta di configurazione da applicare al file agama-installer.kiwi
    derivato dal branch openSUSE:Slowroll/agama-installer.
-->

<!-- 1. Modifica della sezione <type image="iso" ...>: aggiunta opzioni kernelcmdline -->
<type image="iso"
      firmware="uefi"
      hybrid="true"
      hybridpersistent="false"
      mediacheck="true"
      flags="overlay"
      volid="mySlowrollOS_Install">
    <bootloader name="grub2" console="gfxterm">
        <!-- inst.auto carica il profilo embedded nella live; inst.install=0 mantiene dischi e utenti interattivi -->
        <bootoptions>inst.auto=file:///usr/share/myslowroll/profile-final.jsonnet inst.install=0</bootoptions>
    </bootloader>
</type>

<!-- 2. Aggiunta repository mySlowrollOS (home:krism) nella sezione dei repository -->
<repository type="rpm-md" priority="90" alias="home_krism">
    <source path="obs://home:krism/openSUSE_Slowroll"/>
</repository>

<!-- 3. Inclusione dei pacchetti mySlowrollOS nell'ambiente Live (sezione <packages type="image">) -->
<packages type="image">
    <package name="myslowroll-policy"/>
    <package name="myslowroll-cc"/>
    <package name="atomic-update"/>
    <package name="criscore1"/>
    <package name="criscore2"/>
</packages>
