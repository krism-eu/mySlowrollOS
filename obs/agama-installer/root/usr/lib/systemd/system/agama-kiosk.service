[Unit]
Description=mySlowrollOS Agama Local Wayland Kiosk (Cage + Firefox)
Documentation=https://github.com/krism-eu/mySlowrollOS
After=systemd-user-sessions.service systemd-logind.service dbus.socket network.target agama.service agama-web-server.service
Wants=systemd-logind.service dbus.socket agama.service agama-web-server.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=root
PAMName=login
Environment=HOME=/root
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=LIBSEAT_BACKEND=logind
Environment=MOZ_ENABLE_WAYLAND=1
Environment=MOZ_DISABLE_CONTENT_SANDBOX=1
Environment=MOZ_DISABLE_GMP_SANDBOX=1
Environment=MOZ_DISABLE_RDD_SANDBOX=1
Environment=MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1
Environment=NO_AT_BRIDGE=1
Environment=WLR_NO_HARDWARE_CURSORS=1
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
ExecStartPre=/usr/bin/mkdir -p -m 0700 /run/user/0
ExecStartPre=/usr/libexec/myslowroll/wait-for-agama.sh
ExecStart=/usr/bin/cage -s -- /usr/bin/firefox --kiosk https://localhost/
ExecStartPost=+sh -c "exec chvt 1"
Restart=always
RestartSec=2
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

# A single hung ExecStartPre must NOT loop forever: cap at 30s, then abort the start
# instead of blocking the graphical.target boot and leaving the console blank (the
# 'black screen with blinking cursor' defect). Restart is still governed by the
# Restart=/RestartSec= directives above.
TimeoutStartSec=30
TimeoutStartFailureMode=abort

[Install]
WantedBy=graphical.target
