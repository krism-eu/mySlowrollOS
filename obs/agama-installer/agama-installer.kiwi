<?xml version="1.0" encoding="utf-8"?>
<!--
    mySlowrollOS Agama Live Installer
    KIWI NG image recipe for openSUSE Slowroll / OBS (kiwi 10.3.11+, schemaversion 8.5)
    Generates a bootable Live ISO that launches Agama semi-interactively
    with embedded offline profile, Wayland Cage kiosk UI, and pre-configured repository/policy settings.
-->
<image schemaversion="8.5" name="agama-installer">
    <description type="system">
        <author>openSUSE / mySlowrollOS</author>
        <contact>https://github.com/krism-eu/mySlowrollOS</contact>
        <specification>mySlowrollOS Agama Live Installer</specification>
    </description>

    <preferences>
        <type image="iso"
              firmware="uefi"
              hybridpersistent="false"
              mediacheck="true"
              flags="overlay"
              volid="mySlowrollOS_Install"
              kernelcmdline="inst.auto=file:///usr/share/myslowroll/profile-final.jsonnet inst.install=0 inst.systemd_boot_preview=1">
            <bootloader name="grub2"/>
        </type>
        <version>1.0.0</version>
        <packagemanager>zypper</packagemanager>
        <rpm-check-signatures>false</rpm-check-signatures>
        <rpm-excludedocs>true</rpm-excludedocs>
        <locale>it_IT</locale>
        <keytable>it</keytable>
        <timezone>Europe/Rome</timezone>
    </preferences>

    <!-- Repository: OBS injected repositories (Slowroll Standard + home:krism) -->
    <repository type="rpm-md">
        <source path="obsrepositories:/"/>
    </repository>

    <!-- Live Environment System Packages (verified against Slowroll repo metadata) -->
    <packages type="image">
        <!-- Kernel & Live Boot Architecture -->
        <package name="kernel-default"/>
        <package name="kernel-firmware-all"/>
        <package name="dracut"/>
        <package name="dracut-kiwi-live"/>
        <package name="grub2"/>
        <package name="grub2-i386-pc"/>
        <package name="grub2-x86_64-efi"/>
        <package name="shim"/>
        <package name="systemd"/>
        <package name="udev"/>
        <package name="dbus-1"/>
        <package name="NetworkManager"/>
        <package name="kbd"/>
        <package name="timezone"/>

        <!-- Filesystem & Disk Management Tools -->
        <package name="btrfsprogs"/>
        <package name="dosfstools"/>
        <package name="e2fsprogs"/>
        <package name="xfsprogs"/>
        <package name="parted"/>
        <package name="util-linux"/>
        <package name="tar"/>
        <package name="gzip"/>
        <package name="curl"/>
        <package name="iproute2"/>
        <package name="squashfs"/>

        <!-- Agama Installer Engine, Web UI & CLI -->
        <package name="agama"/>
        <package name="agama-cli"/>
        <package name="agama-web-ui"/>
        <package name="agama-autoinstall"/>

        <!-- Local Graphical Kiosk (Wayland Cage + Firefox) -->
        <package name="cage"/>
        <package name="MozillaFirefox"/>
        <package name="MozillaFirefox-branding-openSUSE"/>
        <package name="xwayland"/>
        <package name="Mesa-dri"/>
        <package name="google-noto-sans-fonts"/>
    </packages>

    <!-- Minimal Bootstrap Packages -->
    <packages type="bootstrap">
        <package name="filesystem"/>
        <package name="glibc-locale"/>
        <package name="openSUSE-release"/>
        <package name="openSUSE-release-appliance-custom"/>
    </packages>
</image>
