#!/usr/bin/env bash
set -euo pipefail

if (( $# != 1 )); then
    printf 'Uso: bash agama/generate-workstation-profile URL_REPO_OBS_CRISCORE\n' >&2
    printf 'Esempio: bash agama/generate-workstation-profile https://download.opensuse.org/repositories/home:USER/openSUSE_Slowroll/\n' >&2
    exit 2
fi

repo_url="${1%/}/"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_dir="$(cd -- "${script_dir}/.." && pwd)"
seed="${repo_dir}/experiments/rootfs/workstation.seed"
out="${script_dir}/workstation.jsonnet"

tmp="$(mktemp)"
trap 'rm -f -- "$tmp"' EXIT

sed -E '/^[[:space:]]*(#|$)/d; s/[[:space:]]+$//' "$seed" > "$tmp"
printf '%s\n' criscore1 criscore2 >> "$tmp"
LC_ALL=C sort -u -o "$tmp" "$tmp"

{
    cat <<EOF
// Generato da experiments/rootfs/workstation.seed.
// Profilo intenzionalmente parziale: niente storage, utenti o password.
// Avviare Agama con inst.install=0 per rivedere e completare manualmente l'installazione.
{
  product: {
    id: "Slowroll",
  },

  software: {
    // Una lista esplicita sostituisce i pattern predefiniti del prodotto.
    patterns: [],
    packages: [
EOF

    while IFS= read -r package; do
        printf '      "%s",\n' "$package"
    done < "$tmp"

    cat <<EOF
    ],
    extraRepositories: [
      {
        alias: "criscore",
        name: "mySlowrollOS criscore",
        url: "${repo_url}",
        priority: 90,
      },
    ],
    onlyRequired: true,
  },
}
EOF
} > "$out"

printf 'Generato %s con %s pacchetti espliciti.\n' "$out" "$(wc -l < "$tmp")"
printf 'Storage volutamente assente: verra completato interattivamente in Agama.\n'
